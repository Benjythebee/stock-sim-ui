{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "../stock-sim-server",
        "--watch",
        "src/index.ts"
      ],
      "port": 3000
    },
    {
      "name": "ui",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "ui-chart",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        ".claude/worktrees/chart-ux",
        "dev",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "ui-verify",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    }
  ]
}
